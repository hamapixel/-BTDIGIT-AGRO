# Copier en .env pour le développement LOCAL, puis remplacer impérativement le mot de passe.
# Ne jamais committer .env. Ne pas utiliser ce mot de passe d'exemple en production.
POSTGRES_DB=btdigit_agro
POSTGRES_USER=btdigit_agro
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_LOCAL_PASSWORD
POSTGRES_PORT=55432

