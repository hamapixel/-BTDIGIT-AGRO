# BTDIGIT AGRO — environnement local uniquement. Copier en .env.
# .env est ignoré par Git. Ne jamais y laisser le mot de passe d'exemple.
POSTGRES_DB=btdigit_agro
POSTGRES_USER=btdigit_agro
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_LOCAL_PASSWORD
POSTGRES_PORT=55432

# Port API BTDIGIT AGRO sur le PC ; le port 8000 est utilisé par SUGU KURA.
# Le port INTERNE du conteneur Django reste 8000.
AGRO_API_PORT=18080
# Frontend sur PC (Vite dev): http://127.0.0.1:15173
AGRO_WEB_PORT=15173

# Backend Django : générer une clé indépendante de celle de PostgreSQL.
# Dans PowerShell : py -3.12 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_DJANGO_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:15173,http://127.0.0.1:15173,http://localhost:5173,http://127.0.0.1:5173
# Le port exposé par AGRO_WEB_PORT doit figurer dans les origines CSRF.
CSRF_TRUSTED_ORIGINS=http://localhost:15173,http://127.0.0.1:15173,http://localhost:5173,http://127.0.0.1:5173

# Phase 2 — inscription immédiate : téléphone ou email + mot de passe.
# Aucun fournisseur OTP n'est requis. Les contacts ne sont pas certifiés.
# Pour une future récupération sécurisée, prévoir un lien email vérifiable.
